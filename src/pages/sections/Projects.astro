---
import Card from "../../components/Card.astro";
---

<section id="projects" class="projects">
    <div class="section-wrap">
        <header class="projects-heading reveal">
            <div>
                <p class="section-kicker">SELECTED WORK</p>
                <h2 class="section-title">Our <span class="accent-text">projects.</span></h2>
            </div>
            <p class="intro">Visual studies that explore motion, identity, and modern design.</p>
        </header>
        <div class="project-grid">
            <Card number="01" title="NOVA Identity" description="A bold visual direction centered on ambition and creative energy." />
            <Card number="02" title="Digital Experiences" description="A responsive design exploration focused on clarity and interaction." />
            <Card number="03" title="Creative Systems" description="A flexible approach to turning complex ideas into clear outcomes." />
        </div>
    </div>
</section>

<style>
    .projects { padding-block:clamp(85px,11vw,135px); background:#111113; border-block:1px solid rgb(255 255 255 / 5%); }
    .projects-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:30px; margin-bottom:38px; }
    .intro { max-width:330px; margin:0 0 4px; color:var(--muted); font-size:13px; line-height:1.7; }
    .project-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    @media(max-width:760px){.project-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:560px){.projects-heading{align-items:flex-start;flex-direction:column}.project-grid{grid-template-columns:1fr}}
</style>
