---
const ratings = [
    { name: "Creative Design", score: 82 },
    { name: "Programming", score: 74 },
    { name: "Website Development", score: 78 },
    { name: "Problem Solving", score: 70 }
];
---
<section id="progress" class="progress-section">
    <div class="progress-inner section-wrap">
        <header class="progress-heading reveal">
        <p class="section-kicker">ALWAYS IN MOTION</p>
        <h2 class="section-title">Our <span class="accent-text">progress.</span></h2>
        <p class="section-description">We keep learning, refining, and expanding what we can create together.</p>
        </header>
        <div class="ratings reveal">
        <h3>Areas we're growing in</h3>
        {ratings.map((rating) => (
            <div class="rating">
                <div class="rating-info">
                    <span>{rating.name}</span>
                    <span>{rating.score}%</span>
                </div>
                <div class="bar">
                    <div class="fill" style={`width:${rating.score}%`}></div>
                </div>
            </div>
        ))}
        <small>Illustrative skill indicators, not verified achievements.</small>
        </div>
    </div>
</section>

<style>
    .progress-section { padding-block:clamp(75px,10vw,120px); background:#111113; border-block:1px solid rgb(255 255 255 / 5%);}
    .progress-inner { display:grid; grid-template-columns:.9fr 1.1fr; align-items:center; gap:clamp(45px,9vw,120px);}
    .ratings h3 { margin:0 0 25px; font-size:14px;}
    .ratings small { color:#77777e; }
    .rating { margin: 25px 0; }

    .rating-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .rating-info span:last-child { color: #ff3b30; }

    .bar {
        height: 9px;
        background: #333;
        border-radius: 10px;
        overflow: hidden;
    }

    .fill {
        height: 100%;
        background: #ff3b30;
        border-radius: 10px;
    }

    .ratings small { color: #888; }

    @media(max-width: 750px) {
        .progress-inner { grid-template-columns:1fr; }
    }
</style>
