---
const steps = [
    { number: "01", title: "Design", description: "Create footwear concepts and styles." },
    { number: "02", title: "Production", description: "Develop quality footwear products." },
    { number: "03", title: "Quality Check", description: "Inspect comfort, materials, and durability." },
    { number: "04", title: "Delivery", description: "Prepare products for customers." }
];

const ratings = [
    { name: "Design Quality", score: 95 },
    { name: "Comfort", score: 90 },
    { name: "Product Quality", score: 92 }
];
---

<section id="process" class="process">
    <p class="subtitle">HOW WE WORK</p>
    <h1>The NOVA Process</h1>

    <div class="steps">
        {steps.map((step) => (
            <article class="step">
                <span>{step.number}</span>
                <h2>{step.title}</h2>
                <p>{step.description}</p>
            </article>
        ))}
    </div>

    <div class="ratings">
        <h2>Our Brand Standards</h2>
        {ratings.map((rating) => (
            <div class="rating">
                <div class="rating-info">
                    <span>{rating.name}</span>
                    <span>{rating.score}%</span>
                </div>
                <div class="bar">
                    <div class="fill" style={`width: ${rating.score}%`}></div>
                </div>
            </div>
        ))}
        <small>Illustrative brand targets, not independently verified customer ratings.</small>
    </div>
</section>

<style>
    .process {
        padding: 90px 8%;
        background: #111;
        color: white;
    }

    .subtitle { color: #ff3b30; letter-spacing: 3px; }

    .steps {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin: 40px 0 70px;
    }

    .step {
        padding: 25px;
        border: 1px solid #333;
        border-radius: 10px;
    }

    .step > span { color: #ff3b30; font-size: 25px; }
    .step p { color: #aaa; line-height: 1.6; }

    .ratings { max-width: 650px; margin: auto; }
    .rating { margin: 25px 0; }

    .rating-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .rating-info span:last-child { color: #ff3b30; }

    .bar {
        height: 9px;
        background: #333;
        border-radius: 10px;
        overflow: hidden;
    }

    .fill {
        height: 100%;
        background: #ff3b30;
        border-radius: 10px;
    }

    .ratings small { color: #888; }

    @media(max-width: 750px) {
        .steps { grid-template-columns: repeat(2, 1fr); }
    }
</style>
