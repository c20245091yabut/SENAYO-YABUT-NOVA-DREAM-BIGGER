---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "NOVA | Dream Bigger. Create Beyond." } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="description" content="NOVA is a creative partnership by yabut_ and Senayo. Dream Bigger. Create Beyond." />
    <title>{title}</title>
</head>

<body>
    <Header />

    <main>
        <slot />
    </main>

    <Footer />

    <script>
        import "../scripts/animation.js";
    </script>
</body>
</html>
