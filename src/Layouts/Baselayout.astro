---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "NOVA Shoes | Dream Bigger" } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NOVA Shoes - Dream Bigger." />
    <title>{title}</title>
</head>

<body>
    <Header />

    <main id="progressBar">
        <slot />
    </main>

    <Footer />

    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
    <script>
        import "../scripts/animation.js";
    </script>
</body>
</html>
